# Canvas calendar feed.
# In Canvas: Calendar -> "Calendar Feed" link (bottom-right) -> copy the URL.
# This URL embeds a secret token; treat it like a password. Never commit the real value.
CANVAS_ICS_URL=https://canvas.example.edu/feeds/calendars/user_XXXXXXXXXXXXXXXX.ics

# Local Ollama model for summarization (must be <=4B params for 8GB RAM).
# NEVER a cloud model.
OLLAMA_MODEL=qwen3:4b
# Non-thinking fallback: used when the primary is too slow or reasons out loud.
OLLAMA_FALLBACK_MODEL=llama3.2
# Optional; defaults to http://localhost:11434.
OLLAMA_HOST=http://localhost:11434

# IANA timezone the briefing renders in (times are stored UTC).
LOCAL_TZ=America/New_York
